{
  "name": "jogo-idle-standalone",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "IDLE_AUTH_MODE=local IDLE_BIND=127.0.0.1 tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "test": "IDLE_SKIP_LISTEN=1 tsx --test lib/jogo-idle/game/__tests__/**/*.test.ts src/__tests__/**/*.test.ts",
    "audit:balance": "tsx scripts/balance-audit/run-all.mjs && tsx scripts/balance-audit/write-docs.mjs",
    "auth:create-admin": "tsx scripts/create-admin.ts",
    "auth:create-player": "tsx scripts/create-player.ts",
    "admin:install": "npm install --prefix admin-ui",
    "admin:dev": "npm run dev --prefix admin-ui",
    "admin:build": "npm run build --prefix admin-ui",
    "props:index": "node scripts/props-index.mjs",
    "postinstall": "npm run admin:install"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "tsx": "^4.20.5",
    "typescript": "~6.0.3"
  }
}
